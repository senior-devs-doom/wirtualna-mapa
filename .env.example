# Opcjonalne. Bez tego pliku aplikacja czyta data/graph_export.json (tryb plikowy, bez Neo4j).
PORT=3000
# Tryb bazy: ustaw NEO4J_URI, wtedy graf jest czytany z Neo4j (wczytanie: python data/migrate_to_neo4j.py)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=main
# Własne bramy IPFS dla zdjęć (lista po przecinku, każda kończy się "/ipfs/")
# IPFS_GATEWAYS=
